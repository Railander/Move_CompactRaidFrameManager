package-as: Move_CompactRaidFrameManager
enable-nolib-creation: no
manual-changelog: CHANGELOG.md

ignore:
    - LICENSE
    - README.md
    - .gitignore
    - .gitattributes
    - tests
    - .github
    # backup: these are gitignored and untracked, never packaged either way
    - AGENTS.md
    - AGENTS_MEMORY.md
